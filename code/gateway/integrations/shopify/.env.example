# Scantopay ← Shopify (Jazz94) connector env. Pass these to the Scantopay server:
#   node --env-file=integrations/shopify/.env server.js

# Your Shopify store domain and a CUSTOM APP Admin API token (write_orders).
SHOPIFY_STORE=jazz94.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# Receiving UPI (AU Bank) + merchant name shown to buyers.
MERCHANT_VPA=arunsamanta17-1@okaxis
MERCHANT_NAME=Jazz94

# Observer ingest token (only if you also run an SMS/Gmail observer).
OBSERVER_TOKEN=change-me
