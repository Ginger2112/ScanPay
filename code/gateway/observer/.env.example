# Scantopay Gmail observer — copy to observer/.env and fill in.
# Run with:  node --env-file=observer/.env observer/gmail-observer.js

# The Gmail inbox that RECEIVES your Axis bank credit alerts (any account).
GMAIL_USER=yourbankalerts@gmail.com
# A Gmail APP PASSWORD (not your login password). Create at:
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Scantopay payment core + the shared observer token (must match the server's OBSERVER_TOKEN).
PG_BASE=http://localhost:6100
OBSERVER_TOKEN=dev-observer-token

# How often to check the inbox, in seconds.
POLL_SEC=15

# Optional: extra alert senders to accept, comma-separated (Axis is always accepted).
# ALERT_SENDERS=alerts@hdfcbank.net
