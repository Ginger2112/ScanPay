# --- Database -------------------------------------------------------------
# Local dev uses SQLite so the project runs with no database server.
# For production, switch prisma/schema.prisma datasource provider to
# "postgresql" and point this at Neon / Supabase / RDS.
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
# Public origin of this gateway. Used to build checkout URLs handed to
# customers, so it must be the externally reachable URL, not localhost, in prod.
APP_URL="http://localhost:3000"

# Secret used to hash merchant API keys before storage. Rotate = invalidate all
# keys, so treat it as permanent per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER="change-me-in-production"

# Shared secret for the queue runner at /api/internal/dispatch-webhooks, which
# flushes pending webhooks and releases expired amount slots. Point a scheduler
# at it roughly every minute. Unset = the endpoint is disabled.
CRON_SECRET=""

# --- Shopify (phase 1) ----------------------------------------------------
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,write_orders"
